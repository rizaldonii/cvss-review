# ==========================================
# Konfigurasi Supabase (Frontend & Backend)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ==========================================
# Rahasia Admin (Server-Side Saja di Vercel)
# JANGAN gunakan prefix VITE_
# ==========================================
# Password khusus admin untuk membuka dashboard rekapitulasi data skripsi
ADMIN_PASSWORD=ganti-dengan-password-rahasia-anda

# (Opsional) Kunci acak untuk menandatangani token sesi admin (HMAC-SHA256)
# Jika dikosongkan, sistem server otomatis menurunkan kunci aman dari ADMIN_PASSWORD
ADMIN_SESSION_SECRET=kunci-rahasia-sesi-acak-panjang
