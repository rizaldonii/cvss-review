# ========================================================
# 1. Cloudflare D1 Database (Database Utama - Aktif 24/7 & Bebas Auto-Pause)
# Disetel di Vercel Settings -> Environment Variables (Production & Preview)
# JANGAN gunakan prefix VITE_ agar kredensial tetap aman di sisi server.
# ========================================================
# ID Akun Cloudflare (ditemukan di URL dashboard Cloudflare / tab Workers & D1)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ID Database D1 (ditemukan pada menu Cloudflare -> Workers & Pages -> D1 -> nama database Anda)
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-uuid

# API Token Cloudflare dengan izin "D1:Edit"
# Dibuat di Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ========================================================
# 2. Rahasia Admin (Server-Side Saja di Vercel)
# ========================================================
# Satu password khusus admin untuk membuka rekapitulasi data skripsi & ekspor (/admin)
ADMIN_PASSWORD=ganti-dengan-password-rahasia-anda

# (Opsional) Kunci acak untuk menandatangani token sesi admin (HMAC-SHA256)
# Jika dikosongkan, sistem server otomatis menurunkan kunci aman dari ADMIN_PASSWORD
ADMIN_SESSION_SECRET=kunci-rahasia-sesi-acak-panjang
